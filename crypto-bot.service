[Unit]
Description=Crypto Analysis Bot & Dashboard
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/crypto-analysis-bot
ExecStart=/home/ubuntu/crypto-analysis-bot/venv/bin/python main.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
